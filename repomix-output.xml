                                <div class="bg-green-500 h-1.5 rounded-full transition-all"
                                    :style="{ width: Math.min((day.maxDuration / 4200) * 100, 100) + '%' }">
                                </div>
                            </div>
                        </div>

                        <!-- Time Range -->
                        <div v-if="day.startTime && day.endTime"
                            class="flex items-center gap-1 text-xs text-muted-foreground">
                            <Clock class="w-3 h-3" />
