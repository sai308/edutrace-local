                            <Users class="w-3 h-3" />
                            {{ $t('analytics.details.calendar.participants', { count: day.participantCount }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Day Details Modal -->
        <DayDetailsModal :is-open="isModalOpen"
