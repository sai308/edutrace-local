                                $t('marks.scales.5point') :
                                selectedFormat === '100-scale' ? $t('marks.scales.100point') : $t('marks.scales.ects') }}

                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
