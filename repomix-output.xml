            expect(result.memberCounts['Group2']).toBe(1); // Charlie

            // Verify Stats for Group1
            const g1 = result.groups.find(g => g.name === 'Group1');

            // Completion
            // Alice: 2/2 tasks = 100%
            // Bob: 1/2 tasks = 50%
            // Avg = 75%
            expect(g1.avgTaskCompletion).toBe(75);

            // Marks
            // Alice: 90 (5), 90 (5) -> Avg 5
            // Bob: 50 (2) -> Avg 2
